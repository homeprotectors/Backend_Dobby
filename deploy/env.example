# Image coordinates are set by the deployment workflow.
IMAGE_REPOSITORY=ghcr.io/homeprotectors/backend_dobby
APP_VERSION=prod-latest
GHCR_DEPLOY_USER=replace-with-github-username

APP_DOMAIN=api.example.com
ACME_EMAIL=operator@example.com
SPRING_PROFILES_ACTIVE=prod

# Use the Supabase IPv4 Session Pooler on port 5432 and require TLS.
DATABASE_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.zulfdzwjmowupwwmrael
DATABASE_PASSWORD=replace-with-supabase-password
# pg_dump uses libpq; PGPASSWORD is read from DATABASE_PASSWORD above.
BACKUP_DATABASE_URL=postgresql://postgres.zulfdzwjmowupwwmrael@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
# Optional HTTPS webhook notified when the systemd backup job fails.
BACKUP_FAILURE_WEBHOOK_URL=

APP_JWT_ISS=duemate-api
APP_JWT_AUD=duemate-app
APP_JWT_ACCESS_TTL_MIN=15
APP_JWT_REFRESH_TTL_DAYS=21
APP_JWT_PRIVATE_PEM_PATH=/run/secrets/jwt_private
APP_JWT_PUBLIC_PEM_PATH=/run/secrets/jwt_public

APPLE_TEAM_ID=replace-me
APPLE_KEY_ID=replace-me
APPLE_CLIENT_ID=replace-me
APPLE_PRIVATE_KEY_P8=replace-me
CORS_ALLOWED_ORIGINS=https://example.com

APP_PUSH_ENABLED=true
APP_PUSH_FCM_CREDENTIALS_PATH=/run/secrets/firebase_service_account
APP_PUSH_FCM_PROJECT_ID=replace-me
APP_PUSH_DAILY_CHORE_REMINDER_CRON=0 0 7 * * *
APP_PUSH_DAILY_CHORE_REMINDER_ZONE=Asia/Seoul
APP_PUSH_MANUAL_DISPATCH_ENABLED=false
APP_PUSH_MANUAL_DISPATCH_SECRET=replace-with-long-random-secret
